# HTTP
HTTP_ADDR=:8080

# PostgreSQL (pgx)
DATABASE_URL=postgres://vullify:vullify@localhost:5432/vullify?sslmode=disable

# Redis (go-redis)
REDIS_ADDR=localhost:6379

# Trivy server (optional; docker-compose exposes trivy on 4954)
TRIVY_SERVER=http://localhost:4954

# Worker (cmd/worker)
TRIVY_PATH=trivy
TRIVY_VERSION=
SCAN_QUEUE_KEY=vullify:scan:queue
SCAN_EVENTS_CHANNEL=vullify:scan:events
WORKER_POOL_SIZE=3
JOB_MAX_RETRIES=3

# Enrichment service (cmd/enricher) — subscribes to SCAN_EVENTS_CHANNEL
KEV_REDIS_KEY=vullify:enrichment:kev_catalog