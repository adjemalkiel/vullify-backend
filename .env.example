# HTTP
HTTP_ADDR=:8080

# PostgreSQL (pgx)
DATABASE_URL=postgres://vullify:vullify@localhost:5432/vullify?sslmode=disable

# SQL migrations (cmd/api runs migrate up on startup; Docker image sets MIGRATIONS_DIR=/migrations)
# MIGRATIONS_DIR=migrations

# Redis (go-redis)
REDIS_ADDR=localhost:6379

# Webhooks (POST /webhooks/dockerhub|github|gitlab) — set credentials.webhook_secret per registry JSON:
# dockerhub: { "webhook_secret": "..." } (Authorization: Bearer or X-Webhook-Token)
# ghcr:      { "github_token": "...", "webhook_secret": "..." } (X-Hub-Signature-256 / X-Hub-Signature)
# gitlab:    { "webhook_secret": "..." } (X-Gitlab-Token)

# Trivy server (optional; docker-compose exposes trivy on 4954)
TRIVY_SERVER=http://localhost:4954

# Worker (cmd/worker)
TRIVY_PATH=trivy
TRIVY_VERSION=
SCAN_QUEUE_KEY=vullify:scan:queue
SCAN_EVENTS_CHANNEL=vullify:scan:events
WORKER_POOL_SIZE=3
JOB_MAX_RETRIES=3

# Enrichment service (cmd/enricher) — subscribes to SCAN_EVENTS_CHANNEL
KEV_REDIS_KEY=vullify:enrichment:kev_catalog

# Scheduler (cmd/api — background tickers; set interval to 0 to disable a task)
SCHEDULER_REGISTRY_SYNC_INTERVAL=1h
SCHEDULER_PERIODIC_RESCAN_INTERVAL=24h
SCHEDULER_CHANGE_DETECTION_INTERVAL=30m
SCHEDULER_STALE_SCAN_AGE=24h
